# ===========================================
# Webman Admin System - 环境变量配置
# 复制此文件为 .env 并填入实际值
# 修改后需重启 Webman（php windows.php / php start.php）才会生效
# ===========================================

# -------------------------------------------
# 应用基础
# -------------------------------------------
# 调试模式：true 时输出更详细的错误信息（生产环境请设为 false）
APP_DEBUG=true
# 应用名称：用于 JWT iss 等标识，可自定义
APP_NAME=WebmanAdmin
# 业务时区（PHP date/报表/订单墙钟）
APP_TIMEZONE=Asia/Shanghai
# MySQL session 时区，建议用固定偏移，避免依赖 mysql 时区表与服务器 SYSTEM
DB_TIMEZONE=+08:00

# -------------------------------------------
# HTTP 服务
# -------------------------------------------
# 监听地址，格式：协议://IP:端口
# 示例：http://0.0.0.0:8787（所有网卡）、http://127.0.0.1:8787（仅本机）
SERVER_LISTEN=http://0.0.0.0:8787

# -------------------------------------------
# MySQL 数据库
# -------------------------------------------
# 数据库驱动，固定为 mysql
DB_CONNECTION=mysql
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库名
DB_DATABASE=webman_admin
# 数据库用户名
DB_USERNAME=root
# 数据库密码（留空表示无密码）
DB_PASSWORD=

# -------------------------------------------
# Redis
# 用于：权限缓存、登录锁定、验证码、Token 黑名单/会话、Refresh Token
# -------------------------------------------
# Redis 主机地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码（无密码留空）
REDIS_PASSWORD=
# Redis 数据库编号（0-15，默认 0）
REDIS_DATABASE=0
# Redis Key 前缀（多项目共用同一 Redis 时用于隔离）
REDIS_PREFIX=pubmatic:

# -------------------------------------------
# JWT 认证
# -------------------------------------------
# JWT 签名密钥（务必改为随机长字符串，生产环境禁止使用默认值）
JWT_SECRET=change-this-to-a-random-secret-key
# Access Token 有效期（秒），默认 7200 = 2 小时
JWT_ACCESS_TTL=7200
# Refresh Token 有效期（秒），默认 604800 = 7 天
JWT_REFRESH_TTL=604800


# 单设备登录：true / 1 / yes 开启
# 开启后同一账号新登录会踢掉旧会话（旧 refresh_token 与 access_token 失效）
AUTH_SINGLE_DEVICE=false

# Refresh Token 轮换：true / 1 / yes 开启（推荐）
# 开启后每次调用 /admin/refresh 会下发新的 refresh_token，旧 refresh_token 立即失效
AUTH_REFRESH_ROTATE=true

# -------------------------------------------
# 登录安全
# -------------------------------------------
# 同一「用户名 + IP」在统计窗口内允许的最大失败次数，超限后临时锁定
LOGIN_MAX_ATTEMPTS=5

# 触发锁定后的锁定时长（分钟）
LOGIN_LOCK_MINUTES=15

# 失败次数统计窗口（秒），默认 900 = 15 分钟
# 窗口内累计失败达 LOGIN_MAX_ATTEMPTS 次即锁定
LOGIN_FAIL_WINDOW_SECONDS=900

# 是否启用登录验证码：true / 1 / yes 开启
# 关闭时仅按失败次数策略决定是否要求验证码
LOGIN_CAPTCHA_ENABLED=false

# 失败多少次后强制要求验证码（LOGIN_CAPTCHA_ENABLED=true 时生效）
# 设为 0 表示每次登录都需要验证码
LOGIN_CAPTCHA_AFTER_FAILURES=3

# 验证码有效期（秒），默认 300 = 5 分钟
LOGIN_CAPTCHA_TTL=300

# -------------------------------------------
# 文件上传
# -------------------------------------------
# 本地上传保存目录（相对项目根目录）
UPLOAD_PATH=public/uploads
# 图片类文件最大大小（字节），默认 5242880 = 5MB
UPLOAD_MAX_SIZE=5242880
# 文档类文件最大大小（字节），默认 10485760 = 10MB
UPLOAD_DOCUMENT_MAX_SIZE=10485760
# 视频上传大小上限（字节，默认 100MB）
UPLOAD_VIDEO_MAX_SIZE=104857600
# Windows 本地若出现 cURL error 60，可指定 CA 证书路径
# CURL_CA_BUNDLE=runtime/ssl/cacert.pem
# 仅本地调试可临时关闭 S3 SSL 校验（生产勿开）
# S3_SSL_VERIFY=true

# -------------------------------------------
# 跨域 CORS
# -------------------------------------------
# 允许的 Origin：* 表示反射请求的 Origin
# 多个域名用英文逗号分隔，例如：https://admin.example.com,https://www.example.com
CORS_ORIGIN=*

# -------------------------------------------
# 后台 IP 白名单
# -------------------------------------------
# 总开关：1 / true / yes 开启，0 / false 关闭
# 具体 IP/CIDR 规则在后台「系统配置 -> IP 白名单」菜单维护，不写在 .env 里
# 开启且白名单为空时：拒绝所有 IP（127.0.0.1 与 ::1 互通）
# 注意：修改此项后必须重启 Webman
ADMIN_IP_WHITELIST_ENABLED=0

# -------------------------------------------
# 支付回调域名（通道 config 不要写回调地址）
# -------------------------------------------
# 异步回调根域名，最终地址：
#   充值 {BASE}/api/notify/recharge
#   代付 {BASE}/api/notify/withdraw
PAYMENT_NOTIFY_BASE_URL=https://your-api-domain.com
# 同步跳转相对路径（前端传 site_origin 后拼接成全地址）
PAYMENT_RETURN_PATH=/#/profile
PAYMENT_CANCEL_PATH=/#/profile

# -------------------------------------------
# webman/push 实时推送（后台充值/提现待审提醒）
# -------------------------------------------
# 是否启用推送
PUSH_ENABLE=true
# Push 服务监听（服务端进程）
PUSH_WEBSOCKET=websocket://0.0.0.0:3131
PUSH_API=http://0.0.0.0:3232
# 服务端触发推送地址（本机）
PUSH_API_LOCAL=http://127.0.0.1:3232
PUSH_APP_KEY=3c89c415de8f06f467e31ebe2f0b86ed
PUSH_APP_SECRET=4955b8a417322c15f9114165a9e37b70
# webhook：可用相对路径（按 SERVER_LISTEN 端口自动拼 http://127.0.0.1:{port}/...），也可写绝对地址
PUSH_CHANNEL_HOOK=/plugin/webman/push/hook
# PUSH_CHANNEL_HOOK=http://127.0.0.1:8999/plugin/webman/push/hook
# 浏览器连接地址：相对路径 /wss（接口会按后台域名拼成 wss://host/wss）；也可直接写绝对地址
# PUSH_CLIENT_URL=/wss
# PUSH_CLIENT_URL=wss://adminpub.messrocts.com/wss
PUSH_CLIENT_URL=/wss
PUSH_ADMIN_CHANNEL=admin-audit
PUSH_NOTICE_CHANNEL=h5-notice
PUSH_MESSAGE_CHANNEL=private-h5-inbox

# -------------------------------------------
# 广告位匹配压测 /api/finance_product/match_bench
# -------------------------------------------
# 留空则不校验 token；配置后请求须带 ?token= 同值
# MATCH_BENCH_TOKEN=your-bench-secret

# -------------------------------------------
# USDT 充付（TRON TRC20）
# -------------------------------------------
PAY_SCHEDULER_ENABLED=true
PAY_SCAN_INTERVAL=30
TRON_NETWORK=mainnet
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_DEPOSIT_CONFIRMATIONS=19
TRON_WITHDRAW_CONFIRMATIONS=19
TRON_FEE_LIMIT=100000000
TRON_HOT_WALLET_ADDRESS=
TRON_HOT_WALLET_PRIVATE_KEY=
TRON_HOT_WALLET_PRIVATE_KEY_ENCRYPTED=
PAY_WEBHOOK_MAX_RETRY=5
PAY_HOT_WALLET_USDT_MIN=100
PAY_HOT_WALLET_TRX_MIN=50
# HD 一单一址（配置后入金不再共用热钱包地址）
TRON_HD_MNEMONIC=
TRON_HD_PASSPHRASE=
TRON_HD_SEED=
# 归集：需 HD 派生私钥；入金地址还要有 TRX/能量才能转出 USDT
PAY_COLLECTION_ENABLED=false
PAY_COLLECTION_MIN=1
