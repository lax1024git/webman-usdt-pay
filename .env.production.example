# ===========================================
# Webman Admin System - 生产环境配置
# 复制为 .env 并修改所有 CHANGE_ME 项
# ===========================================

APP_DEBUG=false
APP_NAME=WebmanAdmin
APP_TIMEZONE=Asia/Shanghai
DB_TIMEZONE=+08:00

SERVER_LISTEN=http://0.0.0.0:8787

# MySQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webman_admin
DB_USERNAME=webman
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATABASE=0
REDIS_PREFIX=pubmatic:

# JWT（务必使用随机长字符串）
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800

# 文件上传
UPLOAD_PATH=public/uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_DOCUMENT_MAX_SIZE=10485760

# 跨域（生产环境填写实际前端域名）
CORS_ORIGIN=https://admin.example.com
