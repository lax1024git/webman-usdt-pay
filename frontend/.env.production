# 正式环境（pnpm build）
VITE_NODE_ENV=production

# 同域部署留空，跨域部署填写 API 地址
VITE_API_BASE_PATH=

# 打包路径
VITE_BASE_PATH=/

# 输出目录
VITE_OUT_DIR=dist

# 标题
VITE_APP_TITLE=OpenXEchange

# 按需引入 element-plus 样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=false

# 关闭 Mock
VITE_USE_MOCK=false

# 使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=false

# 删除 debugger / console
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true

# sourcemap
VITE_SOURCEMAP=false

# 包分析（需要时改为 true）
VITE_USE_BUNDLE_ANALYZER=false

# 构建时开启 ESLint 语法检查（不含 prettier 格式）
VITE_ESLINT=true

# 是否切割 CSS
VITE_USE_CSS_SPLIT=true
