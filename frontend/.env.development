# 开发环境（pnpm dev）
VITE_NODE_ENV=development

# 后端 API 地址（必须 https，否则 OPTIONS 预检会被 http→https 重定向拦截）
VITE_API_BASE_PATH=http://127.0.0.1:8999

# 打包路径
VITE_BASE_PATH=/

# 标题
VITE_APP_TITLE=OpenXEchange

# 全量引入 element-plus 样式（开发更方便）
VITE_USE_ALL_ELEMENT_PLUS_STYLE=true

# 关闭 Mock
VITE_USE_MOCK=false

# 使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=false

# 是否删除 debugger / console
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false

# sourcemap
VITE_SOURCEMAP=true

# 开发关闭 ESLint 插件可加快 HMR（需要时改为 true）
VITE_ESLINT=false
